{
  "name": "obsidian-google-blogger-publisher",
  "version": "0.1.3",
  "description": "Publish notes to Google Blogger, with tables and images that render correctly.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -p tsconfig.build.json -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json -noEmit -skipLibCheck",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "plugin",
    "blogger"
  ],
  "author": "Giljae Joo",
  "license": "MIT",
  "devDependencies": {
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^20.10.4",
    "esbuild": "0.17.3",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "jsdom": "^24.1.3",
    "juice": "^9.1.0",
    "markdown-it": "^13.0.1",
    "markdown-it-footnote": "^4.0.0",
    "mathjax-full": "^3.2.2",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^1.6.1"
  }
}
