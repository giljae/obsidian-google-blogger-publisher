{
  "name": "obsidian-google-blogger-publisher",
  "version": "0.1.1",
  "description": "Publish notes to Google Blogger, with tables and images that render correctly.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "blogger"
  ],
  "author": "Giljae Joo",
  "license": "MIT",
  "devDependencies": {
    "@types/lodash-es": "^4.17.6",
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^20.10.4",
    "builtin-modules": "^3.2.0",
    "esbuild": "0.17.3",
    "jsdom": "^24.1.3",
    "juice": "^9.1.0",
    "lodash-es": "^4.17.21",
    "markdown-it": "^13.0.1",
    "markdown-it-footnote": "^4.0.0",
    "mathjax-full": "^3.2.2",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
